{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions supplémentaires de centime sur mobile : scan du QR code d'appairage et export de fichiers dans le dossier de téléchargement de l'application",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-open-app-settings",
    "barcode-scanner:allow-scan",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$DOWNLOAD" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
