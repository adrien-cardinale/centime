{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "centime",
  "identifier": "ch.centime.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../web/dist-desktop",
    "beforeDevCommand": "bun run --cwd ../web dev:desktop",
    "beforeBuildCommand": "bun run --cwd ../web build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "centime",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/adrien-cardinale/centime/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMkM5QTZEOTY0M0RDODgKUldTSTNFT1diWm9zb2hRend5b0EwR1hjUTZqQThOeStNQlhEUk1Yazk4aHBDK09OdlhTejVtaDUK"
    }
  }
}
